# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///leads.db

# API Keys
GOOGLE_PLACES_API_KEY=your-google-places-api-key
YELP_API_KEY=your-yelp-api-key
FACEBOOK_ACCESS_TOKEN=your-facebook-access-token

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Calendly Integration
CALENDLY_API_KEY=your-calendly-api-key
CALENDLY_EVENT_TYPE_URL=https://calendly.com/your-username/15min

# Business Configuration
BUSINESS_NAME=Best Version Media - Castle Hills
BUSINESS_PHONE=(555) 123-4567
BUSINESS_EMAIL=info@bvm-castlehills.com
TARGET_ZIP_CODES=75056,75010,75001,75024,75034,75056,75098,76034,76092,76262

# Application Settings
LEADS_PER_PAGE=20
AUDIT_REPORT_LOGO=static/images/bvm_logo.png
